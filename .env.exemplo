# Arquivo de configuração para o automatizador de relatórios
# Renomeie este arquivo para .env e preencha suas credenciais

# Credenciais do sistema Acade One
ACADE_USUARIO=sergiofilho
ACADE_SENHA=123456

# URL base do ambiente Acade One (adicione endereço correto do seu ambiente)
ACADE_BASE_URL=https://martins.acadeone.com.br

# Configurações opcionais
TIMEOUT_DEFAULT=30
HEADLESS_MODE=False
LOG_LEVEL=INFO

# Diretório para salvar relatórios (opcional)
OUTPUT_DIR=./relatorios/

# Formato padrão de saída
DEFAULT_FORMAT=csv