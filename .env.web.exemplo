# Variáveis da aplicação web (NÃO coloque credenciais do ACADE aqui).

# Chave de 32 bytes em base64 para cifrar o cache de credenciais no navegador.
# Gere com:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Trocar esta chave invalida o acesso de todos os usuários (novo login).
APP_SECRET_KEY=

# Ambiente ACADE
ACADE_BASE_URL=https://martins.acadeone.com.br

# Validade do cache de credenciais em dias (máximo 15)
CRED_TTL_DIAS=15

# Atualizar pessoas: Física e Jurídica ao mesmo tempo (dois navegadores).
# Use false se o servidor tiver pouca memória.
PESSOAS_PARALELO=true

# Baixa pelo retorno: navegadores em paralelo (1 a 6). Cada um é um Chromium.
BAIXA_WORKERS=3
